<?xml version="1.0"?>
<ruleset name="Governance Guardrails Focused Checks">
	<description>Focused WPCS rules for production-risk checks in Governance Guardrails runtime code.</description>

	<file>governance-guardrails.php</file>
	<file>governance-guardrails</file>

	<exclude-pattern>*/governance-guardrails/governance-guardrails-config.php</exclude-pattern>
	<exclude-pattern>*/governance-guardrails/class-cli.php</exclude-pattern>

	<arg name="extensions" value="php" />
	<arg value="sp" />

	<rule ref="WordPress.Security.EscapeOutput" />
	<rule ref="WordPress.Security.ValidatedSanitizedInput" />
	<rule ref="WordPress.DB.DirectDatabaseQuery" />
	<rule ref="WordPress.DB.PreparedSQL" />
</ruleset>
