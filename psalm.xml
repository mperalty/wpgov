<?xml version="1.0"?>
<psalm
    errorLevel="2"
    resolveFromConfigFile="true"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
    phpVersion="8.3"
    allConstantsGlobal="true"
>
    <projectFiles>
        <directory name="wp-governance" />
        <file name="wp-governance.php" />
        <ignoreFiles>
            <directory name="vendor" />
            <file name="wp-governance/wp-governance-config.php" />
        </ignoreFiles>
    </projectFiles>

    <stubs>
        <file name="vendor/php-stubs/wordpress-stubs/wordpress-stubs.php" />
        <file name="vendor/php-stubs/wp-cli-stubs/wp-cli-stubs.php" />
    </stubs>

    <issueHandlers>
        <UndefinedConstant errorLevel="suppress" />
        <PossiblyUnusedMethod errorLevel="suppress" />
        <PossiblyUnusedParam errorLevel="suppress" />
        <UnusedClass errorLevel="suppress" />
        <UnresolvableInclude errorLevel="suppress" />
        <PossiblyUnusedReturnValue errorLevel="suppress" />
        <InvalidStringClass errorLevel="suppress" />
        <ParadoxicalCondition errorLevel="suppress" />
        <MissingClassConstType errorLevel="suppress" />
    </issueHandlers>
</psalm>
